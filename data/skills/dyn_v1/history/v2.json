      "skill_id": "skill_uncletian",
      "skill_name": "目标牌优先预算：事件牌当硬性支出而非收尾动作",
      "description": "当关卡把「打出N张事件牌」与胜利并列时，先判断哪个目标才是真瓶颈：本例胜利仅失败1/10，而事件牌失败10/10，说明卡组战力够、但骰子与行动全被技能对拼吃掉。可复用的做法是把目标事件牌当作每轮的第一笔预算——开局换牌全力找低费事件牌，前两轮各预留足够骰子并主动打出一张（事件牌要花骰也要花一次行动，越晚越容易被结束回合或对拼挤掉），之后再把剩余资源投入装备、支援等长期收益与输出节奏。同时注意手牌每轮抽2张、上限10张，牌囤在手里不算进度，费用不够时用元素调和把多余手牌换成所需骰子来兑现目标。",
      "conditions": {
        "objective_types": [
          "play_event_cards",
          "win_within_rounds"
        ],
        "round_max": 5
      },
      "layer": "strategy",
      "evidence": {
        "games": 0
      },
      "version": 1,
      "status": "active",
      "source_games": [
        "uncletian:profile"
      ],
